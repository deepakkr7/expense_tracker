rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/account_lifecycle/$(uid));
    }
    match /expense_tracker/users/users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.id == uid;
      allow update: if owner(uid) && request.resource.data.id == uid
        && request.resource.data.id == resource.data.id;
      // Account deletion is server-side, including all subcollections.
      allow delete: if false;
      match /{collection}/{document=**} {
        allow read, write: if owner(uid) && collection in [
          'expenses', 'budgets', 'monthly_expenses', 'bill_reminders',
          'borrowed_money', 'friends', 'groups', 'split_expenses', 'savings_goals'
        ];
      }
    }
    // Preserve the previously deployed policy for unrelated applications in this
    // shared project. These permissions never apply to SpendWise or its backend.
    // Other applications still need their own independent security review.
    match /{topLevel}/{document=**} {
      allow read, write: if request.auth != null
        && !(topLevel in ['expense_tracker', 'account_lifecycle', 'service_usage']);
    }
    // SpendWise reports, quotas and lifecycle markers remain backend-only.
  }
}
